@model Test2.Models.Designation

@{
    ViewBag.Title = "Delete Designation";
}

<div class="container mt-5">
    <h2 class="mb-4 text-danger">Delete Confirmation</h2>

    <div class="alert alert-warning">
        <h5 class="mb-0">Are you sure you want to delete this designation?</h5>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 fw-bold">
                    @Html.DisplayNameFor(model => model.DesignationName)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.DesignationName)
                </dd>
            </dl>
        </div>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="mt-4 d-flex justify-content-between">
            <input type="submit" value="Yes, Delete" class="btn btn-danger" />
            <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
        </div>
    }
</div>
